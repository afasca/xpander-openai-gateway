# ============ xpander OpenAI 兼容网关 配置样例 ============
# 复制本文件为 .env 后填写。WebUI 里的修改会自动写回 .env，无需手改。

# 服务端口
PORT=8300

# 网关 API 鉴权 Key（/v1 接口 Bearer 校验；多个用英文逗号分隔）
# WebUI 管理后台（/）免登录直接访问
API_KEYS=123456

# 上游账号池：粘贴 chat.xpander.ai 的登录 Cookie
# 获取方式: 浏览器 F12 → Application → Cookies → https://chat.xpander.ai
#           复制 sb-svc-sb-auth-token.0 与 sb-svc-sb-auth-token.1 两个值按序拼接
#           （也可直接粘贴整行 Cookie 请求头，程序自动提取）
# 多个账号用 ||| 分隔，例如:  base64-AAA|||base64-BBB
XP_COOKIES=

# 停用账号列表（账号 ID，英文逗号分隔；WebUI 开关自动维护，勿手改）
XP_DISABLED=

# 默认模型（/v1/models 可见完整列表；格式 provider/model_id，或别名 sonnet-5 / opus-5 等）
DEFAULT_MODEL=amazon_bedrock/global.anthropic.claude-sonnet-5

# 工具开关（1=开 0=关；WebUI「工具开关」页自动维护）
XP_TOOLS=think_harder=0,deep_planning=0

# 兜底智能体 ID（一般留空）。每个账号导入 Cookie 后会自动创建专属裸 agent（GW-Raw，无内置提示词）
# 并默认使用；仅当自动创建失败时才回落到此值或账号下第一个智能体
XP_AGENT_ID=

# 账号 → 专属 agent 映射（网关自动维护，格式 accid:agentid,...；勿手改）
XP_AGENT_MAP=

# Supabase 匿名 Key（公开值，用于 token 刷新与 rest 接口；一般无需修改）
XP_SUPABASE_ANON_KEY=

# 上游地址（一般无需修改）
XP_SUPABASE_URL=https://svc-sb.app.xpander.ai
XP_CHAT_BACKEND=https://chat-backend.xpander.ai

# 酒馆预设注入（网关自动维护，JSON 数组 [{role,content,name}]；WebUI「酒馆预设」页导入，勿手改）
XP_PRESET=
